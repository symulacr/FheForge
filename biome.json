{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"files": {
		"includes": [
			"package.json",
			"biome.json",
			"ui/**/*.{js,ts,tsx,json,md}",
			"backend/apps/**/*.{js,ts,tsx,json,md}",
			"contracts/**/*.{js,ts,tsx,json,md}",
			"packages/**/*.{js,ts,tsx,json,md}",
			"!packages/**/dist/",
			"!bun.lock",
			"!node_modules",
			"!ui/.next",
			"!backend/apps/dist",
			"!contracts/artifacts",
			"!contracts/cache",
			"!contracts/out",
			"!.agents"
		]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": [
				"backend/apps/src/**/*.controller.ts",
				"backend/apps/src/**/*.service.ts",
				"backend/apps/src/**/*.guard.ts",
				"backend/apps/src/**/*.strategy.ts",
				"backend/apps/src/**/*.interceptor.ts",
				"backend/apps/src/**/*.module.ts",
				"backend/apps/src/**/*.repository.impl.ts",
				"backend/apps/src/**/*.repository.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"useImportType": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"indentStyle": "space",
			"indentWidth": 2
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	}
}
