{
  "title": "Contract Interactions",
  "uid": "contract-interactions",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "title": "Transaction Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(contract_interaction_total[5m])", "legendFormat": "tx/s" }]
    },
    {
      "title": "Gas Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "rate(gas_used_total[5m])", "legendFormat": "gas/s" }]
    },
    {
      "title": "Success Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [{ "expr": "rate(contract_interaction_total{status=\"success\"}[5m]) / rate(contract_interaction_total[5m])", "legendFormat": "success ratio" }]
    }
  ]
}
