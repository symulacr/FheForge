{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Connections Schema",
  "description": "JSON Schema draft-07 for forge-integration/connections.json — cross-reference matrix linking backend-manifest to forge-manifest",
  "type": "object",
  "required": [
    "version",
    "generated",
    "mission",
    "description",
    "prerequisites",
    "connections",
    "walletContextMapping",
    "connectModalSteps",
    "gaps",
    "dependencyGraph",
    "loadingErrorEmptyMatrix"
  ],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mission": { "type": "string" },
    "description": { "type": "string" },
    "prerequisites": {
      "type": "object",
      "required": ["backendManifest", "forgeManifest"],
      "additionalProperties": false,
      "properties": {
        "backendManifest": { "type": "string" },
        "forgeManifest": { "type": "string" }
      }
    },
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "forgeElement",
          "forgeFile",
          "forgeSection",
          "forgeType",
          "backendSource",
          "backendType",
          "backendRef",
          "effort",
          "loadingState",
          "errorState",
          "emptyState",
          "fhePath",
          "publicPath",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^conn-" },
          "forgeElement": { "type": "string" },
          "forgeFile": { "type": "string", "pattern": "^ui/" },
          "forgeSection": { "type": "string" },
          "forgeType": {
            "type": "string",
            "enum": [
              "screen-section",
              "shared-component",
              "state-field",
              "contract-read",
              "contract-read+api",
              "contract-write",
              "contract-write+api",
              "api",
              "hook",
              "utility",
              "state"
            ]
          },
          "backendSource": { "type": "string" },
          "backendType": {
            "type": "string",
            "enum": [
              "contract-read",
              "contract-write",
              "api",
              "contract-read+api",
              "contract-write+api",
              "hook",
              "api+wallet",
              "utility",
              "state"
            ]
          },
          "backendRef": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              { "type": "null" }
            ]
          },
          "effort": { "type": "string", "pattern": "^\\d+(\\.\\d+)?[hd]$" },
          "loadingState": { "type": "string" },
          "errorState": { "type": "string" },
          "emptyState": { "type": "string" },
          "fhePath": { "type": "boolean" },
          "publicPath": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "walletContextMapping": {
      "type": "object",
      "required": ["description", "contextSource", "fields"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "contextSource": { "type": "string" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "forgeField",
              "forgeType",
              "forgeFile",
              "backendSource",
              "backendType",
              "effort",
              "loadingState",
              "errorState",
              "emptyState",
              "fhePath",
              "notes"
            ],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^wallet-ctx-" },
              "forgeField": { "type": "string" },
              "forgeType": { "type": "string" },
              "forgeFile": { "type": "string" },
              "backendSource": { "type": "string" },
              "backendType": { "type": "string" },
              "effort": { "type": "string" },
              "loadingState": { "type": "string" },
              "errorState": { "type": "string" },
              "emptyState": { "type": "string" },
              "fhePath": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "connectModalSteps": {
      "type": "object",
      "required": ["description", "modalFile", "steps", "flowSummary"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "modalFile": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "forgeComponent",
              "stepNumber",
              "backendSource",
              "backendType",
              "effort",
              "loadingState",
              "errorState",
              "emptyState",
              "fhePath",
              "notes"
            ],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^conn-modal-step" },
              "name": { "type": "string" },
              "forgeComponent": { "type": "string" },
              "stepNumber": { "type": "integer", "minimum": 0 },
              "backendSource": { "type": "string" },
              "backendType": { "type": "string" },
              "effort": { "type": "string" },
              "loadingState": { "type": "string" },
              "errorState": { "type": "string" },
              "emptyState": { "type": "string" },
              "fhePath": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        },
        "flowSummary": { "type": "string" }
      }
    },
    "gaps": {
      "type": "object",
      "required": ["description", "items"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "forgeElement", "forgeFile", "description", "recommendation"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^gap-" },
              "forgeElement": { "type": "string" },
              "forgeFile": { "type": "string" },
              "description": { "type": "string" },
              "recommendation": { "type": "string" }
            }
          }
        }
      }
    },
    "dependencyGraph": {
      "type": "object",
      "required": ["description", "edges"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "type"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                ]
              },
              "type": { "type": "string", "enum": ["ui", "data", "tx", "wallet", "auth"] }
            }
          }
        }
      }
    },
    "loadingErrorEmptyMatrix": {
      "type": "object",
      "required": ["description", "patterns", "crossCuttingConcerns"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "patterns": {
          "type": "object",
          "patternProperties": {
            "^[a-z-]+$": {
              "type": "object",
              "required": ["loading", "error", "empty"],
              "additionalProperties": false,
              "properties": {
                "loading": { "type": "string" },
                "error": { "type": "string" },
                "empty": { "type": "string" }
              }
            }
          },
          "additionalProperties": false
        },
        "crossCuttingConcerns": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z]+$": {
              "type": "object",
              "required": ["loading", "error", "empty"],
              "additionalProperties": false,
              "properties": {
                "loading": { "type": "string" },
                "error": { "type": "string" },
                "empty": { "type": "string" }
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
