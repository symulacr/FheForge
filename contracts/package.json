{
  "name": "fheforge-contracts",
  "private": true,
  "scripts": {
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "test:live": "HARDHAT_EXPERIMENTAL_ALLOW_NON_LOCAL_INSTALLATION=true node node_modules/.bin/hardhat run scripts/test-live.ts --network arb-sepolia",
    "test:live:base": "HARDHAT_EXPERIMENTAL_ALLOW_NON_LOCAL_INSTALLATION=true node node_modules/.bin/hardhat run scripts/test-live.ts --network base-sepolia",
    "test": "HARDHAT_EXPERIMENTAL_ALLOW_NON_LOCAL_INSTALLATION=true node node_modules/.bin/hardhat test",
    "deploy:arb": "HARDHAT_EXPERIMENTAL_ALLOW_NON_LOCAL_INSTALLATION=true node node_modules/.bin/hardhat run scripts/deploy.ts --network arb-sepolia",
    "deploy:base": "HARDHAT_EXPERIMENTAL_ALLOW_NON_LOCAL_INSTALLATION=true node node_modules/.bin/hardhat run scripts/deploy.ts --network base-sepolia"
  },
  "devDependencies": {
    "@cofhe/abi": "0.5.1",
    "@cofhe/hardhat-plugin": "0.5.1",
    "@cofhe/mock-contracts": "0.5.1",
    "@cofhe/sdk": "0.5.1",
    "@fhenixprotocol/cofhe-contracts": "0.1.3",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.0.0",
    "chai": "^4.4.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.22.0",
    "prettier": "3.8.3",
    "prettier-plugin-solidity": "2.3.1",
    "solhint": "^6.2.1",
    "solhint-plugin-prettier": "0.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@pythnetwork/pyth-sdk-solidity": "^4.3.1",
    "fhenix-hardhat-plugin": "^0.3.2"
  }
}
