# Copy this file to `backend/apps/.env.development` and fill in real values.

# Server
NODE_ENV=development
PORT=3001

# CORS — comma-separated list. Falls back to localhost dev origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase (required for any persistence). Use the service-role key on the
# server; the UI uses the anon key.
SUPABASE_URL=
SUPABASE_KEY=

# Sentry error tracking (optional). Leave empty to disable.
SENTRY_DSN=

# Gemini AI (required by ai-strategy-builder).
GEMINI_API_KEY=

# RPC — code reads COFHE_RPC (FHENIX_RPC kept as backward-compat alias).
COFHE_RPC=https://sepolia-rollup.arbitrum.io/rpc
FHENIX_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Deployed contract addresses on Arbitrum Sepolia (redeployed 2026-06-05).
# Source: contracts/deployments/421614.json
STRATEGY_VAULT_ADDRESS=0xe9486B12261D02BeB236355934981d49c5697fb3
VAULT_ADDRESS=0xe9486B12261D02BeB236355934981d49c5697fb3
LENDING_POOL_ADDRESS=0x2e04961e0d4448FeeeA5b23593eC81C1C9A2cD2a
POOL_ADDRESS=0x2e04961e0d4448FeeeA5b23593eC81C1C9A2cD2a
PRICE_ORACLE_ADDRESS=0x8E41d720173c347740C05011FadD3a3B015ae18c
STRATEGY_REGISTRY_ADDRESS=0xEbBD1aFDCC888116a4c3800ec856c8c3b1535374
REGISTRY_ADDRESS=0xEbBD1aFDCC888116a4c3800ec856c8c3b1535374
COMPOSER_ADDRESS=0xBcaEF72afA1f207F44C5aa11E48a7bea4b71632C
