# Copy this file to `contracts/.env` and fill in real values.
# Never commit the resulting `.env` file.

# Deployer / signer key (required for any deploy or live test script).
# Use a fresh key — leaked keys must be rotated. Format: 0x-prefixed 32-byte hex.
PRIVATE_KEY=

# RPC endpoints for the supported test networks.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# SwapRouter executor address. Defaults to the deployer if unset.
# In production, this MUST be a multi-sig — the executor is fully trusted to
# honour intent slippage off-chain (see SwapRouter.sol NATSPEC).
SWAP_EXECUTOR_ADDRESS=

# Live-test configuration (only required by scripts/test-hardened.js
# and scripts/test-sharp.js).
TESTER1_PRIVATE_KEY=
TESTER2_PRIVATE_KEY=
TESTER3_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
STRATEGY_VAULT_ADDRESS=
LENDING_POOL_ADDRESS=
SWAP_ROUTER_ADDRESS=
STRATEGY_REGISTRY_ADDRESS=
WETH_ADDRESS=
USDC_ADDRESS=
