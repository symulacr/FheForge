# FheForge Backend — Environment Example
# ========================================
# Copy this file to `backend/apps/.env.production` and fill in real values.
# Never commit the populated `.env.production` file.
#
# Derived from .env.production — secrets stripped.
# ========================================

# Server
NODE_ENV=production
PORT=3000

# CORS — comma-separated list of allowed origins.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# JWT signing secret (generate with: openssl rand -hex 32).
JWT_SECRET=

# Supabase (service-role key).
SUPABASE_URL=
SUPABASE_KEY=

# Sentry (optional — leave empty to disable).
SENTRY_DSN=

# Gemini AI (required by ai-strategy-builder).
GEMINI_API_KEY=

# RPC — CoFHE TaskManager endpoint.
COFHE_RPC=https://sepolia-rollup.arbitrum.io/rpc
FHENIX_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Deployed contract addresses on Arbitrum Sepolia (421614) — Wave 30.
# Source: contracts/deployments/421614.json
STRATEGY_VAULT_ADDRESS=
VAULT_ADDRESS=
LENDING_POOL_ADDRESS=
POOL_ADDRESS=
PRICE_ORACLE_ADDRESS=
STRATEGY_REGISTRY_ADDRESS=
REGISTRY_ADDRESS=
COMPOSER_ADDRESS=
SWAP_ROUTER_ADDRESS=
EXECUTOR_ADDRESS=
STRATEGY_EXECUTOR_ADDRESS=
TOKEN_REGISTRY_ADDRESS=
TIMELOCK_ADDRESS=
GOVERNOR_ADDRESS=
UNISWAP_V3_ROUTER=

# Token addresses on Arbitrum Sepolia.
TOKEN_WETH=
TOKEN_USDC=
TOKEN_USDT=

# APY assumptions (basis points).
SUPPLY_APY_BPS=650
BORROW_APY_BPS=550

# Exchange rates & params.
EXCHANGE_RATE_WETH_USDC=3000
EXCHANGE_RATE_USDC_USDT=1
MAX_LTV=0.75
