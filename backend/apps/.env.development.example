# Copy this file to `backend/apps/.env.development` and fill in real values.

# Server
NODE_ENV=development
PORT=3001

# CORS — comma-separated list. Falls back to localhost dev origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase (required for any persistence). Use the service-role key on the
# server; the UI uses the anon key.
SUPABASE_URL=
SUPABASE_KEY=

# Sentry error tracking (optional). Leave empty to disable.
SENTRY_DSN=

# Gemini AI (required by ai-strategy-builder).
GEMINI_API_KEY=

# RPC — code reads COFHE_RPC (FHENIX_RPC kept as backward-compat alias).
COFHE_RPC=https://sepolia-rollup.arbitrum.io/rpc
FHENIX_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Deployed contract addresses on Arbitrum Sepolia (Wave 30, redeployed 2026-06-05).
# Source: contracts/deployments/421614.json
STRATEGY_VAULT_ADDRESS=0xd3d24E7b57f1d7AceBD1e11e415EB7E7c6c60267
VAULT_ADDRESS=0xd3d24E7b57f1d7AceBD1e11e415EB7E7c6c60267
