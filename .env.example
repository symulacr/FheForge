# FheForge — Root Environment Example
# =====================================
# Copy this file to `.env` in the relevant sub-package and fill in real values.
# Never commit a populated `.env` file.
#
# This file aggregates ALL required env vars across:
#   - contracts/     (Solidity deployment & testing)
#   - ui/            (Next.js frontend)
#   - backend/apps/  (NestJS API)
#
# =====================================
#
# ──────────────────────────────────────────────
# CONTRACTS (contracts/.env)
# ──────────────────────────────────────────────
# Deployer / signer key (0x-prefixed 32-byte hex).
PRIVATE_KEY=
# RPC endpoints.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# SwapRouter executor address (defaults to deployer if unset).
SWAP_EXECUTOR_ADDRESS=
# Live-test signers (only required by test scripts).
TESTER1_PRIVATE_KEY=
TESTER2_PRIVATE_KEY=
TESTER3_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
# Deployed contract addresses (live test targets).
STRATEGY_VAULT_ADDRESS=
LENDING_POOL_ADDRESS=
SWAP_ROUTER_ADDRESS=
STRATEGY_REGISTRY_ADDRESS=
WETH_ADDRESS=
USDC_ADDRESS=

# ──────────────────────────────────────────────
# UI (ui/.env.local)
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_CHAIN_ID=421614
# Contract addresses on Arbitrum Sepolia.
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_POOL_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_ORACLE_ADDRESS=
NEXT_PUBLIC_COMPOSER_ADDRESS=
NEXT_PUBLIC_SWAP_ROUTER_ADDRESS=
NEXT_PUBLIC_EXECUTOR_CONTRACT_ADDRESS=
NEXT_PUBLIC_TOKEN_REGISTRY_ADDRESS=
NEXT_PUBLIC_STRATEGY_EXECUTOR_ADDRESS=
# Same set of contracts on Base Sepolia (leave blank if not deployed).
NEXT_PUBLIC_BASE_VAULT_ADDRESS=
NEXT_PUBLIC_BASE_POOL_ADDRESS=
NEXT_PUBLIC_BASE_ROUTER_ADDRESS=
NEXT_PUBLIC_BASE_REGISTRY_ADDRESS=
NEXT_PUBLIC_BASE_COMPOSER_ADDRESS=
NEXT_PUBLIC_BASE_SWAP_ROUTER_ADDRESS=
NEXT_PUBLIC_BASE_ORACLE_ADDRESS=
# Token addresses.
NEXT_PUBLIC_TOKEN_WETH=
NEXT_PUBLIC_TOKEN_USDC=
NEXT_PUBLIC_TOKEN_USDT=
NEXT_PUBLIC_UNISWAP_V3_ROUTER=
# WalletConnect project ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Supabase (UI uses anon key only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────
# BACKEND (backend/apps/.env.development)
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# CORS — comma-separated origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Supabase service-role key.
SUPABASE_URL=
SUPABASE_KEY=
# Sentry (optional).
SENTRY_DSN=
# Gemini AI (required by ai-strategy-builder).
GEMINI_API_KEY=
# RPC.
COFHE_RPC=https://sepolia-rollup.arbitrum.io/rpc
# Deployed contract addresses.
STRATEGY_VAULT_ADDRESS=
LENDING_POOL_ADDRESS=
PRICE_ORACLE_ADDRESS=
STRATEGY_REGISTRY_ADDRESS=
COMPOSER_ADDRESS=
SWAP_ROUTER_ADDRESS=
EXECUTOR_ADDRESS=
# Token addresses.
TOKEN_WETH=
TOKEN_USDC=
TOKEN_USDT=
# APY assumptions (basis points).
SUPPLY_APY_BPS=650
BORROW_APY_BPS=550
# Exchange rates & params.
EXCHANGE_RATE_WETH_USDC=3000
EXCHANGE_RATE_USDC_USDT=1
MAX_LTV=0.75
