# Copy this file to `ui/.env.local` and fill in real values.

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public site URL — used for OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App version surfaced in the footer.
NEXT_PUBLIC_APP_VERSION=0.1.0

# Default chain id for the app (Arbitrum Sepolia).
NEXT_PUBLIC_CHAIN_ID=421614

# FheForge core contract addresses on Arbitrum Sepolia. After deployment,
# `contracts/scripts/forge-deploy.ts` writes these to contracts/deployments/421614.env.
NEXT_PUBLIC_VAULT_ADDRESS=0xf3cB0A1b02128C630C2bca9b50151FbC350f6AFC
NEXT_PUBLIC_POOL_ADDRESS=0x6903df3E8f45497C3097A16E534787D6Fc9F58eF
NEXT_PUBLIC_REGISTRY_ADDRESS=0xC1256f738f1bF9D08F8168eE48e34d4E929DDE9C
NEXT_PUBLIC_ORACLE_ADDRESS=0xFB8fb4232f70bF41750515F54861b0698938ceDe
NEXT_PUBLIC_COMPOSER_ADDRESS=0x65dB0572076f14b838327F5C2513f32b927Ec36E
NEXT_PUBLIC_SWAP_ROUTER_ADDRESS=0x1136E5eF8bB8E189aE83894eCB2F0c67E3097Ea1
NEXT_PUBLIC_EXECUTOR_CONTRACT_ADDRESS=0x80EF32CE77f5DC7aA92d200f36357cd83ef8407D
NEXT_PUBLIC_TOKEN_REGISTRY_ADDRESS=0x7aF5d7E762D895C917EA3c9e72Ca134176A32AD3
NEXT_PUBLIC_STRATEGY_EXECUTOR_ADDRESS=0x9eCC8c61F65EBB652d3DfA3A32Eac08487CC1e00

# Same set of contracts on Base Sepolia (84532). Leave blank if not deployed.
NEXT_PUBLIC_BASE_VAULT_ADDRESS=
NEXT_PUBLIC_BASE_POOL_ADDRESS=
NEXT_PUBLIC_BASE_ROUTER_ADDRESS=
NEXT_PUBLIC_BASE_REGISTRY_ADDRESS=
NEXT_PUBLIC_BASE_COMPOSER_ADDRESS=
NEXT_PUBLIC_BASE_SWAP_ROUTER_ADDRESS=
NEXT_PUBLIC_BASE_ORACLE_ADDRESS=

# ERC-20 token addresses (the ones the UI knows how to encode amounts for).
NEXT_PUBLIC_TOKEN_WETH=0x84BddCAfaccbBDBc0e3F1CAcCDd352EBf5e40A32
NEXT_PUBLIC_TOKEN_USDC=0x150376EdEbc5AC48771655a61a795d828BeC8Df6
NEXT_PUBLIC_TOKEN_USDT=
NEXT_PUBLIC_UNISWAP_V3_ROUTER=0x101F443B4d1b059569D643917553c771E1b9663E

# WalletConnect project ID (required for wallet connection).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Supabase (UI uses anon key only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
