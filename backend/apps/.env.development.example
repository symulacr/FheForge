# Copy this file to `backend/apps/.env.development` and fill in real values.

# Server
NODE_ENV=development
PORT=3001

# CORS — comma-separated list. Falls back to localhost dev origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase (required for any persistence). Use the service-role key on the
# server; the UI uses the anon key.
SUPABASE_URL=
SUPABASE_KEY=

# Gemini AI (required by ai-strategy-builder).
GEMINI_API_KEY=

# Token addresses on Arbitrum Sepolia (used by the AI strategy builder).
TOKEN_WETH=
TOKEN_USDC=
TOKEN_USDT=

# Static APY assumptions used by the simulation engine (basis points).
SUPPLY_APY_BPS=650
BORROW_APY_BPS=550

# Fhenix RPC for FhenixStrategyService.
FHENIX_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Optional: exchange rates used by FhenixStrategyService.
EXCHANGE_RATE_WETH_USDC=3000
EXCHANGE_RATE_USDC_USDT=1
MAX_LTV=0.75
