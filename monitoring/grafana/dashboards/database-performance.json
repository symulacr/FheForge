{
  "title": "Database Performance",
  "uid": "database-performance",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "database_connections_active", "legendFormat": "active" }]
    },
    {
      "title": "Query Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(database_query_duration_seconds_bucket[5m]))", "legendFormat": "p95" }]
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [{ "expr": "rate(database_errors_total[5m])", "legendFormat": "errors" }]
    }
  ]
}
