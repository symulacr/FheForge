# Copy this file to `backend/apps/.env.development` and fill in real values.

# Server
NODE_ENV=development
PORT=3001

# CORS — comma-separated list. Falls back to localhost dev origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase (required for any persistence). Use the service-role key on the
# server; the UI uses the anon key.
SUPABASE_URL=
SUPABASE_KEY=

# Sentry error tracking (optional). Leave empty to disable.
SENTRY_DSN=

# Gemini AI (required by ai-strategy-builder).
GEMINI_API_KEY=

# RPC — code reads COFHE_RPC (FHENIX_RPC kept as backward-compat alias).
COFHE_RPC=https://sepolia-rollup.arbitrum.io/rpc
FHENIX_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Deployed contract addresses on Arbitrum Sepolia (Wave 30).
# Source: contracts/deployments/421614.json — verified on-chain.
STRATEGY_VAULT_ADDRESS=0xf3cB0A1b02128C630C2bca9b50151FbC350f6AFC
VAULT_ADDRESS=0xf3cB0A1b02128C630C2bca9b50151FbC350f6AFC
LENDING_POOL_ADDRESS=0x6903df3E8f45497C3097A16E534787D6Fc9F58eF
POOL_ADDRESS=0x6903df3E8f45497C3097A16E534787D6Fc9F58eF
PRICE_ORACLE_ADDRESS=0xFB8fb4232f70bF41750515F54861b0698938ceDe
STRATEGY_REGISTRY_ADDRESS=0xC1256f738f1bF9D08F8168eE48e34d4E929DDE9C
REGISTRY_ADDRESS=0xC1256f738f1bF9D08F8168eE48e34d4E929DDE9C
COMPOSER_ADDRESS=0x65dB0572076f14b838327F5C2513f32b927Ec36E
SWAP_ROUTER_ADDRESS=0x1136E5eF8bB8E189aE83894eCB2F0c67E3097Ea1
EXECUTOR_ADDRESS=0x80EF32CE77f5DC7aA92d200f36357cd83ef8407D

# Token addresses on Arbitrum Sepolia (used by AI strategy builder + simulators).
TOKEN_WETH=0x84BddCAfaccbBDBc0e3F1CAcCDd352EBf5e40A32
TOKEN_USDC=0x150376EdEbc5AC48771655a61a795d828BeC8Df6
TOKEN_USDT=

# Static APY assumptions used by the simulation engine (basis points).
SUPPLY_APY_BPS=650
BORROW_APY_BPS=550

# Optional: exchange rates used by FhenixStrategyService fallback.
EXCHANGE_RATE_WETH_USDC=3000
EXCHANGE_RATE_USDC_USDT=1
MAX_LTV=0.75
